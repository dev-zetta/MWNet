<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout" version="3.2.0">
    <Widget type="Window" skin="MW_Dialog" position="0 0 780 520" layer="Modal" name="_Main">

        <!-- Title -->
        <Widget type="TextBox" skin="ProgressText" position="8 8 300 20" align="Left Top" name="TitleLabel">
            <Property key="Caption" value="Server Browser"/>
            <Property key="TextAlign" value="Left"/>
        </Widget>

        <!-- Server list -->
        <Widget type="ListBox" skin="MW_List" position="8 32 440 300" align="Left Top HStretch VStretch" name="ServerList">
        </Widget>

        <!-- Details panel -->
        <Widget type="TextBox" skin="ProgressText" position="456 32 140 18" align="Left Top" name="LabelName">
            <Property key="Caption" value="Server name"/>
        </Widget>
        <Widget type="TextBox" skin="ProgressText" position="456 52 300 18" align="Left Top" name="ServerName">
            <Property key="Caption" value=""/>
        </Widget>

        <Widget type="TextBox" skin="ProgressText" position="456 78 140 18" align="Left Top" name="LabelPlayers">
            <Property key="Caption" value="Players"/>
        </Widget>
        <Widget type="TextBox" skin="ProgressText" position="456 98 300 18" align="Left Top" name="ServerPlayers">
            <Property key="Caption" value=""/>
        </Widget>

        <Widget type="TextBox" skin="ProgressText" position="456 124 140 18" align="Left Top" name="LabelGamemode">
            <Property key="Caption" value="Game mode"/>
        </Widget>
        <Widget type="TextBox" skin="ProgressText" position="456 144 300 18" align="Left Top" name="ServerGamemode">
            <Property key="Caption" value=""/>
        </Widget>

        <Widget type="TextBox" skin="ProgressText" position="456 170 140 18" align="Left Top" name="LabelPing">
            <Property key="Caption" value="Ping"/>
        </Widget>
        <Widget type="TextBox" skin="ProgressText" position="456 190 300 18" align="Left Top" name="ServerPing">
            <Property key="Caption" value=""/>
        </Widget>

        <!-- Player list -->
        <Widget type="TextBox" skin="ProgressText" position="456 220 300 18" align="Left Top" name="LabelPlayerList">
            <Property key="Caption" value="Online players"/>
        </Widget>
        <Widget type="ListBox" skin="MW_List" position="456 240 310 92" align="Left Top" name="PlayerList">
        </Widget>

        <!-- Address bar -->
        <Widget type="TextBox" skin="ProgressText" position="8 342 140 20" align="Left Bottom" name="LabelAddress">
            <Property key="Caption" value="Address : Port"/>
        </Widget>
        <Widget type="EditBox" skin="MW_TextEdit" position="8 364 380 28" align="Left Bottom HStretch" name="EditAddress"/>
        <Widget type="AutoSizedButton" skin="MW_Button" position="396 364 56 28" align="Left Bottom" name="ButtonRefresh">
            <Property key="ExpandDirection" value="Right"/>
            <Property key="Caption" value="Refresh"/>
        </Widget>

        <!-- Connect / Cancel -->
        <Widget type="AutoSizedButton" skin="MW_Button" position="620 480 72 28" align="Right Bottom" name="ButtonConnect">
            <Property key="ExpandDirection" value="Left"/>
            <Property key="Caption" value="Connect"/>
        </Widget>
        <Widget type="AutoSizedButton" skin="MW_Button" position="700 480 64 28" align="Right Bottom" name="ButtonCancel">
            <Property key="ExpandDirection" value="Left"/>
            <Property key="Caption" value="Cancel"/>
        </Widget>

        <!-- Status label -->
        <Widget type="TextBox" skin="ProgressText" position="8 486 440 20" align="Left Bottom" name="StatusLabel">
            <Property key="Caption" value="Querying master server..."/>
            <Property key="TextAlign" value="Left"/>
        </Widget>

    </Widget>
    <CodeGeneratorSettings/>
</MyGUI>
